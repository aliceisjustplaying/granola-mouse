#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
action="${1:-build}"
port="${2:-/dev/cu.usbmodem101}"
# Accept a device label (A, B, ...) anywhere a port is expected.
if [[ "$port" != /dev/* ]]; then
  port="$("$root/scripts/device" port "$port")"
fi

if ! command -v eim >/dev/null 2>&1; then
  echo "eim is required" >&2
  exit 1
fi

cd "$root"
case "$action" in
  build)
    eim run "idf.py -B build -DGRANOLA_PROTO_AUDIO=OFF build"
    ;;
  audio|build-audio)
    eim run "idf.py -B build-audio -DGRANOLA_PROTO_AUDIO=ON build"
    ;;
  flash)
    eim run "idf.py -B build -p '$port' flash"
    ;;
  flash-audio)
    eim run "idf.py -B build-audio -DGRANOLA_PROTO_AUDIO=ON -p '$port' flash"
    ;;
  monitor)
    eim run "idf.py -B build -p '$port' monitor"
    ;;
  *)
    echo "usage: $0 {build|audio|flash [PORT]|flash-audio [PORT]|monitor [PORT]}" >&2
    exit 2
    ;;
esac
